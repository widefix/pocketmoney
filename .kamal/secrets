# Kamal resolves the names listed under `registry/password`, `env/secret` and
# `accessories/*/env/secret` in config/deploy.yml from this file.
#
# No raw credentials here: every value is read from .env.production, which is
# gitignored. Copy .env.production.example to .env.production and fill it in.

KAMAL_REGISTRY_PASSWORD=$(grep -m1 '^KAMAL_REGISTRY_PASSWORD=' .env.production | cut -d= -f2-)
SECRET_KEY_BASE=$(grep -m1 '^SECRET_KEY_BASE=' .env.production | cut -d= -f2-)
DB_PASSWORD=$(grep -m1 '^DB_PASSWORD=' .env.production | cut -d= -f2-)
POSTGRES_PASSWORD=$(grep -m1 '^DB_PASSWORD=' .env.production | cut -d= -f2-)
GOOGLE_CLIENT_SECRET=$(grep -m1 '^GOOGLE_CLIENT_SECRET=' .env.production | cut -d= -f2-)
FACEBOOK_APP_SECRET=$(grep -m1 '^FACEBOOK_APP_SECRET=' .env.production | cut -d= -f2-)
AWS_ACCESS_KEY_ID=$(grep -m1 '^AWS_ACCESS_KEY_ID=' .env.production | cut -d= -f2-)
AWS_ACCESS_SECRET_KEY_ID=$(grep -m1 '^AWS_ACCESS_SECRET_KEY_ID=' .env.production | cut -d= -f2-)
SMTP_PASSWORD=$(grep -m1 '^SMTP_PASSWORD=' .env.production | cut -d= -f2-)
ROLLBAR_ACCESS_TOKEN=$(grep -m1 '^ROLLBAR_ACCESS_TOKEN=' .env.production | cut -d= -f2-)
NEW_RELIC_LICENSE_KEY=$(grep -m1 '^NEW_RELIC_LICENSE_KEY=' .env.production | cut -d= -f2-)
