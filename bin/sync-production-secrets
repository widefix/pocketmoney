#!/usr/bin/env bash
# Decrypts config/deploy/production.secrets.vault.yml into .kamal/secrets, the
# dotenv file Kamal reads. Everyone who deploys needs only the vault password;
# the encrypted vault itself is committed.
#
#   bin/sync-production-secrets
#
# Password lookup: $ANSIBLE_VAULT_PASSWORD_FILE, else
# config/deploy/.production-vault-password (gitignored).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

VAULT_FILE="config/deploy/production.secrets.vault.yml"
OUTPUT_FILE=".kamal/secrets"
VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-config/deploy/.production-vault-password}"

abort() { echo "sync-production-secrets: $1" >&2; exit 1; }

command -v ansible-vault >/dev/null || abort "ansible-vault not installed (brew install ansible / pip install ansible-core)"
[ -f "$VAULT_FILE" ] || abort "missing $VAULT_FILE"
[ -f "$VAULT_PASSWORD_FILE" ] || abort "missing vault password file: $VAULT_PASSWORD_FILE"

# Decrypt into a private temp file outside the repo, always cleaned up, so a
# failure can never leave plaintext secrets lying around in the working tree.
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
chmod 700 "$tmpdir"

# ansible-vault refuses to run unless stdin/stdout/stderr are blocking, which
# is not guaranteed when this runs from a CI step or another tool; give it
# plain files for all three.
if ! ansible-vault view --vault-password-file "$VAULT_PASSWORD_FILE" "$VAULT_FILE" \
     < /dev/null > "$tmpdir/plain.yml" 2> "$tmpdir/err"; then
  sed 's/^/  /' "$tmpdir/err" >&2
  abort "could not decrypt $VAULT_FILE (wrong password?)"
fi

python3 - "$tmpdir/plain.yml" > "$tmpdir/secrets" <<'PY'
import sys, yaml

data = yaml.safe_load(open(sys.argv[1])) or {}
if not isinstance(data, dict) or not data:
    sys.exit("vault does not contain a non-empty mapping of secrets")

# config/deploy.yml asks for these names; they reuse another secret's value, so
# the vault stores each password once and the aliases are derived here.
ALIASES = {"POSTGRES_PASSWORD": "DB_PASSWORD", "MB_DB_PASS": "METABASE_DB_PASSWORD"}
for alias, source in ALIASES.items():
    if source in data:
        data[alias] = data[source]

def dotenv(value):
    s = "" if value is None else str(value)
    for a, b in (("\\", "\\\\"), ('"', '\\"'), ("$", "\\$"), ("`", "\\`"), ("\n", "\\n")):
        s = s.replace(a, b)
    return f'"{s}"'

print("# Generated by bin/sync-production-secrets. Do not edit or commit.")
for key in sorted(data):
    print(f"{key}={dotenv(data[key])}")
PY

mkdir -p "$(dirname "$OUTPUT_FILE")"
install -m 600 "$tmpdir/secrets" "$OUTPUT_FILE"
echo "Wrote $OUTPUT_FILE ($(grep -c '^[A-Z]' "$OUTPUT_FILE") secrets)"
