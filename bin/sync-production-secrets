#!/usr/bin/env bash
# Decrypts config/deploy/production.secrets.vault.yml into .kamal/secrets, the
# dotenv file Kamal reads. Everyone who deploys needs only the vault password;
# the encrypted vault itself is committed.
#
#   bin/sync-production-secrets
#
# Password lookup: $ANSIBLE_VAULT_PASSWORD_FILE, else
# config/deploy/.production-vault-password (gitignored).
#
# The vault holds one flat `KEY: value` pair per line. Values may be bare,
# 'single-quoted' or "double-quoted"; nested YAML is rejected.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

VAULT_FILE="config/deploy/production.secrets.vault.yml"
OUTPUT_FILE=".kamal/secrets"
VAULT_PASSWORD_FILE="${ANSIBLE_VAULT_PASSWORD_FILE:-config/deploy/.production-vault-password}"

# config/deploy.yml asks for these names; they reuse another secret's value, so
# the vault stores each password once and the aliases are derived here.
ALIASES=("POSTGRES_PASSWORD=DB_PASSWORD" "MB_DB_PASS=METABASE_DB_PASSWORD")

abort() { echo "sync-production-secrets: $1" >&2; exit 1; }

command -v ansible-vault >/dev/null || abort "ansible-vault not installed (brew install ansible / pipx install ansible-core)"
[ -f "$VAULT_FILE" ] || abort "missing $VAULT_FILE"
[ -f "$VAULT_PASSWORD_FILE" ] || abort "missing vault password file: $VAULT_PASSWORD_FILE"

# Decrypt into a private temp dir outside the repo, always cleaned up, so a
# failure can never leave plaintext secrets lying around in the working tree.
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
chmod 700 "$tmpdir"

# ansible-vault refuses to run unless stdin/stdout/stderr are blocking, which
# is not guaranteed when this runs from a CI step or another tool; give it
# plain files for all three.
if ! ansible-vault view --vault-password-file "$VAULT_PASSWORD_FILE" "$VAULT_FILE" \
     < /dev/null > "$tmpdir/plain.yml" 2> "$tmpdir/err"; then
  sed 's/^/  /' "$tmpdir/err" >&2
  abort "could not decrypt $VAULT_FILE (wrong password?)"
fi

# Strips YAML quoting from a scalar.
unquote() {
  local v="$1"
  local q="'"   # a variable: bash 3.2 keeps the backslash in "${v//\'\'/\'}"
  if [[ "$v" =~ ^\'(.*)\'$ ]]; then
    v="${BASH_REMATCH[1]}"
    v="${v//$q$q/$q}"
  elif [[ "$v" =~ ^\"(.*)\"$ ]]; then
    v="${BASH_REMATCH[1]}"
    v="${v//\\\"/\"}"
    v="${v//\\\\/\\}"
  fi
  printf '%s' "$v"
}

# Escapes a value for a double-quoted dotenv entry.
quote_dotenv() {
  local v="${1//\\/\\\\}"
  v="${v//\"/\\\"}"
  v="${v//\$/\\\$}"
  v="${v//\`/\\\`}"
  printf '"%s"' "$v"
}

# Parallel indexed arrays rather than `declare -A`: macOS ships bash 3.2,
# which has no associative arrays.
keys=()
values=()

set_secret() {
  local i
  for i in "${!keys[@]}"; do
    if [[ "${keys[$i]}" == "$1" ]]; then values[$i]="$2"; return; fi
  done
  keys+=("$1")
  values+=("$2")
}

# Prints the value of a secret; fails if it is not defined.
get_secret() {
  local i
  for i in "${!keys[@]}"; do
    if [[ "${keys[$i]}" == "$1" ]]; then printf '%s' "${values[$i]}"; return 0; fi
  done
  return 1
}

lineno=0
while IFS= read -r line || [ -n "$line" ]; do
  lineno=$((lineno + 1))
  [[ "$line" =~ ^[[:space:]]*(#.*)?$ || "$line" == "---" ]] && continue
  if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*):[[:space:]]*(.*)$ ]]; then
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    value="${value%"${value##*[![:space:]]}"}"   # trim trailing whitespace
    set_secret "$key" "$(unquote "$value")"
  else
    abort "line $lineno of the vault is not a flat 'KEY: value' pair"
  fi
done < "$tmpdir/plain.yml"

((${#keys[@]} > 0)) || abort "vault contains no secrets"

for alias in "${ALIASES[@]}"; do
  target="${alias%%=*}" source="${alias#*=}"
  if value="$(get_secret "$source")"; then set_secret "$target" "$value"; fi
done

{
  echo "# Generated by bin/sync-production-secrets. Do not edit or commit."
  while IFS= read -r key; do
    printf '%s=%s\n' "$key" "$(quote_dotenv "$(get_secret "$key")")"
  done < <(printf '%s\n' "${keys[@]}" | LC_ALL=C sort)
} > "$tmpdir/secrets"

mkdir -p "$(dirname "$OUTPUT_FILE")"
install -m 600 "$tmpdir/secrets" "$OUTPUT_FILE"
echo "Wrote $OUTPUT_FILE (${#keys[@]} secrets)"
