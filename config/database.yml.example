default: &default
  adapter: postgresql
  encoding: unicode
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>
  timeout: 5000
  host: <%= ENV.fetch("DB_HOST") { "localhost" } %>
  port: <%= ENV.fetch("DB_PORT") { 5432 } %>

development:
  <<: *default
  database: budgetingkid_development

test:
  <<: *default
  database: budgetingkid_test

production:
  <<: *default
  database: <%= ENV.fetch("DB_NAME") { "budgetingkid_production" } %>
  username: <%= ENV.fetch("DB_USER") { "budgetingkid" } %>
  password: <%= ENV.fetch("DB_PASSWORD") { nil } %>
