# Kamal resolves the names listed under `registry/password`, `env/secret` and
# `accessories/*/env/secret` in config/deploy.yml from this file.
#
# No raw credentials here: bin/kamal-secret reads each value from the
# environment (CI) or from .env.production (gitignored, for local deploys).

KAMAL_REGISTRY_PASSWORD=$(bin/kamal-secret KAMAL_REGISTRY_PASSWORD)
SECRET_KEY_BASE=$(bin/kamal-secret SECRET_KEY_BASE)
DB_PASSWORD=$(bin/kamal-secret DB_PASSWORD)
POSTGRES_PASSWORD=$(bin/kamal-secret DB_PASSWORD)
GOOGLE_CLIENT_SECRET=$(bin/kamal-secret GOOGLE_CLIENT_SECRET)
FACEBOOK_APP_SECRET=$(bin/kamal-secret FACEBOOK_APP_SECRET)
AWS_ACCESS_KEY_ID=$(bin/kamal-secret AWS_ACCESS_KEY_ID)
AWS_ACCESS_SECRET_KEY_ID=$(bin/kamal-secret AWS_ACCESS_SECRET_KEY_ID)
SMTP_PASSWORD=$(bin/kamal-secret SMTP_PASSWORD)
ROLLBAR_ACCESS_TOKEN=$(bin/kamal-secret ROLLBAR_ACCESS_TOKEN)
NEW_RELIC_LICENSE_KEY=$(bin/kamal-secret NEW_RELIC_LICENSE_KEY)
MB_DB_PASS=$(bin/kamal-secret METABASE_DB_PASSWORD)
