#!/usr/bin/env bash
# Resolves one deployment secret by name.
#
# Environment first, so CI can inject secrets without a file on disk; then
# .env.production, which is gitignored and used for deploys from a workstation.
set -euo pipefail

name="${1:?usage: bin/kamal-secret NAME}"

if [[ -n "${!name:-}" ]]; then
  printf '%s' "${!name}"
  exit 0
fi

if [[ -f .env.production ]]; then
  # `|| true`: a missing key must fall through to the error below, not
  # abort silently under `set -e`.
  value="$(grep -m1 "^${name}=" .env.production | cut -d= -f2- || true)"
  if [[ -n "$value" ]]; then
    printf '%s' "$value"
    exit 0
  fi
fi

echo "kamal-secret: '${name}' is set neither in the environment nor in .env.production" >&2
exit 1
