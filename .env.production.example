# Kamal deployment secrets. Copy to .env.production and fill in real values.
# .env.production is gitignored — never commit it.
# Consumed by .kamal/secrets, which is consumed by config/deploy.yml.

# GitHub PAT with write:packages scope for ghcr.io/jasirguzman123
KAMAL_REGISTRY_PASSWORD=

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=
# Password for the Postgres accessory (POSTGRES_PASSWORD and the app's DB_PASSWORD)
DB_PASSWORD=

# OAuth
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_SECRET=

# ActiveStorage / S3
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET_KEY_ID=

# Mailgun SMTP
SMTP_PASSWORD=

# Monitoring
ROLLBAR_ACCESS_TOKEN=
NEW_RELIC_LICENSE_KEY=
